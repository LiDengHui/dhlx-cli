        "@types/readline-sync": "^1.4.8",
        "archiver": "^7.0.1",
        "commander": "^12.1.0",
        "figlet": "^1.7.0",
        "gh-pages": "^6.3.0",
        "git-clone": "^0.2.0",
        "inquirer": "^11.0.2",
        "lodash": "^4.17.21",
        "mammoth": "^1.9.0",
        "node-ssh": "^13.2.0",
        "ora": "^8.1.0",
        "shelljs": "^0.8.5",
        "xlsx": "^0.18.5"
