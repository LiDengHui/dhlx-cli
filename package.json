        "@types/lodash": "^4.17.23",
        "@types/ssh2": "^1.15.5",
        "ava": "^6.4.1",
        "husky": "^9.1.7",
        "jscpd": "^4.0.8",
        "lint-staged": "^16.2.7",
        "oxfmt": "^0.31.0",
        "oxlint": "^1.46.0",
        "readline-sync": "^1.4.10",
        "sharp": "^0.34.5",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-tsconfig-paths": "^6.1.0"
    },
