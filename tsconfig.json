{
    "compilerOptions": {
        "lib": ["ESNext"],
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2021",
        "useDefineForClassFields": true,
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts"]
}
